{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mci2",
  "main": "worker.js",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "2026091101",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
